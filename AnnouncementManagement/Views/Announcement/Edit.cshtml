@model AnnouncementManagement.ViewModels.AnnouncementEditViewModel

@{
    ViewData["Title"] = "編輯公告";
}

<h2>編輯公告</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id"
           type="hidden" />

    <partial name="_AnnouncementForm"
             model="Model" />

    <button type="submit"
            class="btn btn-primary">
        儲存
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        返回
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}