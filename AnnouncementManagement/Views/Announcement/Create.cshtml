@model AnnouncementManagement.ViewModels.AnnouncementEditViewModel

@{
    ViewData["Title"] = "新增公告";
}

<h2>新增公告</h2>

<form asp-action="Create" method="post">

    <partial name="_AnnouncementForm"
             model="Model" />

    <button type="submit"
            class="btn btn-primary">
        儲存
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        返回
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}